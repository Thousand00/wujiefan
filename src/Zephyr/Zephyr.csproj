<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zephyr</RootNamespace>
    <AssemblyName>Zephyr</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\zephyr.ico</ApplicationIcon>
    <!--
      与 Ui/Theme.cs 注释里的声明保持一致。不写这一项时 WinForms 的实际行为是
      SystemAware: 主显示器上清晰, 拖到另一块缩放比不同的屏幕上会被位图拉伸发糊,
      而我们的布局又是按 Dpi.Px(DeviceDpi) 手工算的 —— 声明与实现不一致时,
      换屏后 Dpi.Px 不会跟着变, 界面就成了"一半锐利一半模糊"。
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Zephyr</Product>
    <Description>机械革命无界14+ 风扇转速监视器 (只读)</Description>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zephyr.Core\Zephyr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\zephyr.ico" LogicalName="Zephyr.zephyr.ico" />
  </ItemGroup>

</Project>
