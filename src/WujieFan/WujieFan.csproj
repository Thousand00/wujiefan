<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WujieFan</RootNamespace>
    <AssemblyName>WujieFan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\wujiefan.ico</ApplicationIcon>
    <Product>WujieFan</Product>
    <Description>机械革命无界14+ 风扇转速监视器 (只读)</Description>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WujieFan.Core\WujieFan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\wujiefan.ico" LogicalName="WujieFan.wujiefan.ico" />
  </ItemGroup>

</Project>
